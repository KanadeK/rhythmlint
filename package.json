{
  "name": "rhythmlint",
  "version": "0.1.0",
  "description": "Policy-as-code for calendar health: audit ICS files for overload, fragmentation, missing focus time, and repair opportunities.",
  "type": "module",
  "license": "MIT",
  "author": "KanadeK <121669563+KanadeK@users.noreply.github.com>",
  "homepage": "https://github.com/KanadeK/rhythmlint#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KanadeK/rhythmlint.git"
  },
  "bugs": {
    "url": "https://github.com/KanadeK/rhythmlint/issues"
  },
  "keywords": [
    "calendar",
    "icalendar",
    "ics",
    "linter",
    "productivity",
    "deep-work",
    "meeting-overload",
    "policy-as-code",
    "local-first"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rhythmlint": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "examples/rhythmlint.config.json",
    "rhythmlint.schema.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-standalone.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "npm run typecheck && node scripts/static-check.mjs",
    "test": "npm run build && node scripts/run-tests.mjs",
    "test:coverage": "npm run build && node scripts/run-tests.mjs --coverage",
    "demo": "npm run build && node scripts/generate-demo.mjs",
    "demo:check": "npm run build && node scripts/generate-demo.mjs --check",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "check": "npm run format:check && npm run lint && npm run test:coverage && npm run demo:check"
  },
  "dependencies": {
    "ical.js": "2.2.1"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "esbuild": "0.28.1",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
